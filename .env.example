# Chave da API do Google Places (Google Cloud Console > APIs & Services)
# Ative "Places API" e restrinja a chave por IP/referrer antes de usar.
GOOGLE_PLACES_API_KEY=

# Seu WhatsApp (quem vai vender o site), formato internacional sem símbolos: 55DDDNUMERO
SEU_WHATSAPP=5579998942945

# Nome/negócio que aparece na proposta e no rodapé dos sites de demonstração
SEU_NOME=Seu Nome

# Valor cobrado pelo site (usado no texto da proposta)
PRECO_SITE=100
